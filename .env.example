# Telegraph x402 payer. Use a Base Sepolia burner wallet with limited test USDC.
TELEGRAPH_EVM_PRIVATE_KEY=
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
PROOFGATE_MAX_TELEGRAPH_PAYMENT_ATOMIC=100000
PROOFGATE_MAX_TARGET_PAYMENT_ATOMIC=50000

# Required for paid production routes. Entered by operators in the console.
PROOFGATE_API_KEY=

# Required before publishing and registering the Miner.
PROOFGATE_PUBLIC_URL=http://localhost:3000
PROOFGATE_MINER_ID=7402
PROOFGATE_REPOSITORY_URL=https://github.com/karan68/proofgate

# Required on serverless deployments for a persistent, atomic audit chain.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace injects equivalent KV_REST_API_URL/KV_REST_API_TOKEN names.
PROOFGATE_AUDIT_REDIS_KEY=proofgate:audit:v1

# Reputation providers. Unconfigured providers are reported as unavailable.
PHISHTANK_APP_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=

# Optional local JSONL audit path. Ignored when Redis is configured.
# PROOFGATE_AUDIT_FILE=C:\absolute\path\proofgate-audit.jsonl