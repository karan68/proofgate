{
  "name": "proofgate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/karan68/proofgate.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mcp:dev": "tsx mcp/server.ts",
    "mcp:build": "esbuild mcp/server.ts --bundle --packages=external --platform=node --format=esm --target=node20 --outfile=dist/mcp/server.js",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@x402/evm": "^2.22.0",
    "@x402/fetch": "^2.22.0",
    "dotenv": "^17.4.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldts": "^7.4.10",
    "undici": "^8.10.0",
    "viem": "^2.55.18",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
